# bash completion for coomer

_coomer() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD-1]}"
  local option="$prev" prefix="" backend="" list i value
  COMPREPLY=()

  # Bash can split --option=value into three words at '='.
  if [[ "$prev" == = && $COMP_CWORD -ge 2 ]]; then
    option="${COMP_WORDS[COMP_CWORD-2]}"
  elif [[ "$cur" == --backend=* || "$cur" == --monitor=* ]]; then
    option="${cur%%=*}"
    prefix="$option="
    cur="${cur#*=}"
  fi

  case "$option" in
    --backend)
      COMPREPLY=( $(compgen -W "auto x11 wlr portal" -- "$cur") )
      ;;
    --monitor)
      for ((i=1; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
          --backend)
            value=$((i+1))
            if [[ "${COMP_WORDS[value]}" == = ]]; then
              value=$((value+1))
            fi
            if ((value < COMP_CWORD)); then
              backend="${COMP_WORDS[value]}"
            fi
            ;;
          --backend=*) backend="${COMP_WORDS[i]#*=}" ;;
        esac
      done

      # Portal enumeration is unsupported.
      [[ "$backend" == portal ]] && return 0
      if [[ -n "$backend" ]]; then
        list="$(command coomer --backend "$backend" --list-monitors 2>/dev/null | awk '/^\[[0-9]+\]/ {print $2}')"
      else
        list="$(command coomer --list-monitors 2>/dev/null | awk '/^\[[0-9]+\]/ {print $2}')"
      fi
      COMPREPLY=( $(compgen -W "all $list" -- "$cur") )
      ;;
    *)
      if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "
          --backend --monitor --list-monitors --overlay --portal-interactive
          --no-spotlight --version --debug --help -h
        " -- "$cur") )
      fi
      ;;
  esac

  if [[ -n "$prefix" ]]; then
    COMPREPLY=( "${COMPREPLY[@]/#/$prefix}" )
  fi
}

complete -F _coomer coomer
